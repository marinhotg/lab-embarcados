# --- Particao ---------------------------------------------------------------
# Bluetooth Classic + Wi-Fi + MQTT nao cabem na particao padrao de 1 MB.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# --- Bluetooth Classic (SPP) ------------------------------------------------
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_SPP_ENABLED=y
CONFIG_BT_BLE_ENABLED=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_MODE_BTDM=n

# --- Coexistencia BT Classic + Wi-Fi ----------------------------------------
# Os dois radios compartilham a antena; sem isto a latencia do SPP degrada
# quando o MQTT publica (secao 2.2 do documento).
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# --- FreeRTOS ---------------------------------------------------------------
# Tick de 1 ms: as tarefas tem periodos de 20/50/100/200 ms (Tabela 6).
CONFIG_FREERTOS_HZ=1000

# --- Misc -------------------------------------------------------------------
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
