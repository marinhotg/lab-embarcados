# Bluetooth Classic + Wi-Fi + MQTT do not fit the default 1 MB app partition.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_SPP_ENABLED=y
CONFIG_BT_BLE_ENABLED=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_MODE_BTDM=n

# Both radios share the antenna; without coexistence SPP latency degrades
# whenever MQTT publishes.
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# 1 ms tick for the 20/50/100/200 ms task periods.
CONFIG_FREERTOS_HZ=1000

CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
